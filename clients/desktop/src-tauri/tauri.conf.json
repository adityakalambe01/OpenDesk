{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDesk",
  "version": "0.1.0",
  "identifier": "io.opendesk.desktop",
  "build": { "beforeDevCommand": "corepack pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "corepack pnpm build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "OpenDesk", "width": 1100, "height": 720 }], "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}

